{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "type": "object",
  "required": ["user_id", "type", "name", "email", "createdAt"],
  "properties": {
    "user_id": {
      "type": "string",
      "pattern": "/^[0-9A-F]{8}-[0-9A-F]{4}-4[0-9A-F]{3}-[89AB][0-9A-F]{3}-[0-9A-F]{12}$/i",
      "description": "Primary Key, in UUIDv4 format"
    },
    "type": {
      "type": "string",
      "enum":["user","admin"],
      "description": "Sort key, always 'user' for normal users or admin for admin users"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Full name of the user"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "User's email address"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of when the user was created"
    }
  },
  "additionalProperties": false
}
